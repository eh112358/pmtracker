# Precious Metals Tracker Configuration

# GoldAPI.io - Live gold and silver spot prices
# Free tier: 300 requests/month
# Sign up at: https://www.goldapi.io/
#
# Each price refresh makes 2 API calls (gold + silver)
# Prices are cached for 30 minutes to conserve API calls
# Without a key, fallback prices are used ($2,650 gold, $30 silver)
GOLDAPI_KEY=

# Database URL (default uses SQLite, no need to change)
# DATABASE_URL=sqlite:///./data/pmtracker.db
